# Hardwin AI Router
# Choose one: openrouter | groq | ollama
AI_PROVIDER=openrouter

# OpenRouter prototype route
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free

# Optional Groq route
GROQ_API_KEY=

# Optional local Ollama route
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Used for provider headers
APP_URL=https://your-hardwin-domain.example
